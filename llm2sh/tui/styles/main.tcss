/* Core Theme & Palette */
$background: #0f172a;      /* slate-900 */
$surface: #1e293b;         /* slate-800 */
$border: #334155;          /* slate-700 */
$accent: #6366f1;          /* indigo-500 */
$text: #f8fafc;            /* slate-50 */
$text-dim: #94a3b8;        /* slate-400 */

Screen {
    background: $background;
    color: $text;
}

#header {
    height: 3;
    background: $surface;
    border-bottom: solid $border;
    content-align: left middle;
    padding: 0 2;
    layout: horizontal;
}

#title {
    width: 1fr;
    text-style: bold;
    color: $accent;
    content-align: left middle;
}

#mode-selector {
    width: auto;
}

#main-container {
    height: 1fr;
    layout: horizontal;
}

HistoryPanel {
    width: 25%;
    max-width: 35;
    background: $background;
    border-right: solid $border;
    padding: 1;
}

HistoryPanel #history-list {
    height: 1fr;
    border: none;
    background: transparent;
}

ResultPanel {
    width: 75%;
    background: $background;
    padding: 1 2;
}

#result-scroll {
    height: 1fr;
    overflow-y: scroll;
}

#command-container {
    background: $surface;
    border: solid $border;
    padding: 1 2;
    margin-bottom: 1;
    color: #38bdf8; /* sky-400 */
}

#action-bar {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#action-bar Button {
    margin-left: 1;
}

InputPanel {
    height: auto;
    min-height: 4;
    background: $surface;
    border-top: solid $border;
    padding: 1 2;
}

InputPanel Input {
    width: 100%;
    border: solid $border;
    background: $background;
    color: $text;
}

InputPanel Input:focus {
    border: solid $accent;
}

/* Confirm Modal Styling */
ConfirmModal {
    align: center middle;
}

#dialog {
    width: 60;
    height: auto;
    background: $surface;
    border: thick $border;
    padding: 1 2;
}

#dialog.caution {
    border: thick #eab308; /* yellow-500 */
}

#dialog.danger {
    border: thick #ef4444; /* red-500 */
}

#dialog-title {
    text-style: bold;
    margin-bottom: 1;
}

#dialog-buttons {
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#dialog-buttons Button {
    margin-left: 1;
}

OutputPane {
    display: none;
    height: 1fr;
    border: solid $border;
    background: $surface;
    margin-top: 1;
    padding: 1;
}

#output-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#output-log {
    height: 1fr;
    background: transparent;
}

#mode-tabs {
    width: auto;
    background: transparent;
    border: none;
    height: 3;
}

#mode-tabs Tab {
    padding: 0 2;
}

/* Onboarding Screen Styling */
OnboardingScreen {
    align: center middle;
    background: rgba(15, 23, 42, 0.7);
}

#onboarding-dialog {
    width: 60;
    height: auto;
    background: $surface;
    border: thick $accent;
    padding: 2 4;
}

#onboarding-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#onboarding-description {
    text-align: center;
    color: $text-dim;
    margin-bottom: 2;
}

#onboarding-input-label {
    margin-bottom: 1;
    text-style: bold;
}

#api-key-input {
    margin-bottom: 2;
}

#onboarding-buttons {
    align: center middle;
    margin-top: 1;
}

/* Settings Screen Styling */
SettingsScreen {
    align: center middle;
    background: rgba(15, 23, 42, 0.7);
}

#settings-dialog {
    width: 70;
    height: 85%;
    background: $surface;
    border: thick $border;
    padding: 2 4;
}

#settings-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 2;
    text-align: center;
}

#settings-form {
    height: 1fr;
    margin-bottom: 2;
}

#settings-form Label {
    margin-top: 1;
    margin-bottom: 1;
    text-style: bold;
}

#settings-form Input, #settings-form Select {
    width: 100%;
}

#settings-dry-run-row {
    margin-top: 2;
    height: 3;
    align: left middle;
}

#settings-dry-run-row Label {
    width: 1fr;
}

#settings-buttons {
    layout: horizontal;
    align: right middle;
    height: 3;
}

#settings-buttons Button {
    margin-left: 2;
}

/* Save Modal Styling */
SaveModal {
    align: center middle;
    background: rgba(15, 23, 42, 0.7);
}

#save-dialog {
    width: 55;
    height: auto;
    background: $surface;
    border: thick $border;
    padding: 2 4;
}

#save-dialog-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#save-path-input {
    margin-top: 1;
    margin-bottom: 2;
}

#save-dialog-buttons {
    layout: horizontal;
    align: right middle;
}

#save-dialog-buttons Button {
    margin-left: 2;
}


